# Create a bot with @BotFather. Never commit the real token.
BOT_TOKEN=123456789:replace_with_your_bot_token

# Numeric IDs are recommended (channels normally start with -100).
SOURCE_CHANNEL_ID=-1001234567890
DEST_CHANNEL_ID=-1009876543210

# Optional settings
DATABASE_PATH=data/copybot.sqlite3
ALBUM_WAIT_SECONDS=1.0
MAX_RETRIES=5
LOG_LEVEL=INFO
